# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env (which is in .gitignore)
#    Command: cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

# Optional: Groq (or OpenAI-compatible) key for live Copilot wording
GROQ_API_KEY=your_groq_key_here_DO_NOT_COMMIT
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
RG_AI_DISABLE=false

# App (no database required; DATABASE_URL is ignored if set)
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RELEASEGRAPH_WORKSPACE=
SHOP_GATEWAY_URL=http://127.0.0.1:8080
SHOP_STOREFRONT_URL=http://127.0.0.1:8082

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use os.getenv("VARIABLE_NAME") to access values
# - Never share credentials with AI assistants like Bob
# ============================================
