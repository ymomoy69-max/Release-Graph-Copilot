ENVIRONMENT=development
DEBUG=true
# Folder ReleaseGraph scans for services, issues, git history, and GO/NO-GO (optional at seed)
RELEASEGRAPH_WORKSPACE=
DATABASE_URL=sqlite:///./data/releasegraph.db
JWT_SECRET=change-me-use-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SHOP_GATEWAY_URL=http://127.0.0.1:8080
SHOP_STOREFRONT_URL=http://127.0.0.1:8082
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
RG_AI_DISABLE=false
